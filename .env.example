# ==============================================================================
# FoodVision AI — Environment Configuration Template (v1.0.0)
# Copy this file to .env and fill in real credentials. NEVER commit .env to Git.
# ==============================================================================

# --- Supabase & PostgreSQL (>= 15) ---
SUPABASE_URL="https://aqjeztwtqkhvjjxnsijs.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only, runtime queries)
DATABASE_URL="postgresql://postgres.aqjeztwtqkhvjjxnsijs:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for DDL migrations)
DIRECT_URL="postgresql://postgres.aqjeztwtqkhvjjxnsijs:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# --- Backend FastAPI Runtime ---
APP_ENV="development"
ALLOWED_ORIGINS="http://localhost:5173"
MAX_UPLOAD_BYTES=5242880
INFERENCE_TIMEOUT_SECONDS=10.0
MAX_CONCURRENT_INFERENCES=2
TRGM_SIMILARITY_THRESHOLD=0.30
MODEL_ARTIFACT_PATH="models/ingredients_best.pt"

# --- Frontend (Vite) ---
VITE_SUPABASE_URL="https://aqjeztwtqkhvjjxnsijs.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"
VITE_API_BASE_URL="http://localhost:8000/api/v1"

